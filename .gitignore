# ---- Python ----
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments (never upload these) ----
.venv/
venv/
env/
test_env/
.env

# ---- Caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Local data & runtime artifacts (regenerated by `make data` / `make train`) ----
data/*.csv
data/*.jsonl
data/*.db
data/*.db-shm
data/*.db-wal
data/reports/
report.html

# ---- Model registry: keep metadata, not the heavy bundle ----
models/registry/*/bundle.json
!models/registry/.gitkeep
